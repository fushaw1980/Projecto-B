{
  "entities": {
    "User": {
      "title": "User Profile",
      "description": "Public user profile information for workers and clients",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "fullName": { "type": "string" },
        "role": { "type": "string", "enum": ["client", "worker", "admin"] },
        "email": { "type": "string" },
        "category": { "type": "string" },
        "specialty": { "type": "string" },
        "specialties": { "type": "array" },
        "bairro": { "type": "string" },
        "city": { "type": "string" },
        "verified": { "type": "boolean" },
        "level": { "type": "number" },
        "jobs": { "type": "number" },
        "balance": { "type": "number" },
        "phone": { "type": "string" },
        "photo": { "type": "string" },
        "portfolio": { "type": "array" },
        "rating": { "type": "number" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["uid", "fullName", "role", "email"]
    },
    "UserPrivateSecurity": {
      "title": "User Private Security Document",
      "description": "Sensitive identity and emergency contact data readable only by the owner or admin",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "biPhoto": { "type": "string" },
        "biSelfie": { "type": "string" },
        "nuit": { "type": "string" },
        "emergencyContactName": { "type": "string" },
        "emergencyContactPhone": { "type": "string" },
        "verified": { "type": "boolean" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId"]
    },
    "Job": {
      "title": "Job Request",
      "description": "A job request created by a client",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "providerId": { "type": "string" },
        "clientId": { "type": "string" },
        "category": { "type": "string" },
        "amount": { "type": "number" },
        "description": { "type": "string" },
        "status": { "type": "string" },
        "transactionId": { "type": "string" },
        "payoutAmount": { "type": "number" },
        "payoutTransactionId": { "type": "string" },
        "photoBefore": { "type": "string" },
        "photoAfter": { "type": "string" },
        "panicAlert": { "type": "boolean" },
        "panicLocation": { "type": "string" },
        "cancellationReason": { "type": "string" },
        "previousStatus": { "type": "string" },
        "cancelledBy": { "type": "string" },
        "rescheduledAt": { "type": "string", "format": "date-time" },
        "rescheduleNote": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["clientId", "category", "amount", "status", "createdAt"]
    },
    "Message": {
      "title": "Message",
      "description": "A chat message",
      "type": "object",
      "properties": {
        "senderId": { "type": "string" },
        "senderRole": { "type": "string" },
        "text": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      }
    },
    "Review": {
      "title": "Review",
      "description": "A review for a provider",
      "type": "object",
      "properties": {
        "rating": { "type": "number" },
        "comment": { "type": "string" },
        "authorId": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["rating", "authorId"]
    },
    "EmergencyAlert": {
      "title": "Emergency Alert",
      "description": "Anti-crime SOS emergency alert",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "userName": { "type": "string" },
        "userRole": { "type": "string" },
        "status": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "status", "createdAt"]
    }
  },
  "firestore": {
    "users/{userId}": {
      "schema": "User",
      "description": "Public user profile data"
    },
    "users/{userId}/private_profile/security": {
      "schema": "UserPrivateSecurity",
      "description": "Sensitive PII and emergency details restricted to owner and admin"
    },
    "jobs/{jobId}": {
      "schema": "Job",
      "description": "Job details and status"
    },
    "jobs/{jobId}/messages/{messageId}": {
      "schema": "Message",
      "description": "Messages within a job's chat"
    },
    "users/{userId}/reviews/{reviewId}": {
      "schema": "Review",
      "description": "Reviews received by a worker"
    },
    "emergency_alerts/{alertId}": {
      "schema": "EmergencyAlert",
      "description": "SOS anti-crime alerts triggered by users"
    }
  }
}
